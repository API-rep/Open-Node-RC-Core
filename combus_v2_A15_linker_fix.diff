+def _add_generated_cpp_to_sources(target_env, out_dir: Path) -> None:
+    """
+    Add the generated combus.cpp to the env's build sources.
+
+    The combus_generated/combus.cpp defines the `ComBus comBus` instance
+    plus the AnalogComBusArray[] and DigitalComBusArray[] runtime data.
+    The legacy architecture (combus-frame-handshake branch) hosted this
+    definition in a static .cpp inside the per-machine config tree; the
+    A12/v2 pipeline moved it into the generated artefacts. To preserve
+    the linker contract for every non-test env (machines, sound_node,
+    remotes, etc.), the generated .cpp must be compiled in addition to
+    being on the CPPPATH.
+
+    Without this step, the linker reports
+        `undefined reference to 'comBus'`
+    on any non-test env that references `comBus` in its translation
+    units (e.g. volvo_A60H_bruder, sound_node_volvo, ...).
+
+    Implementation: this hook is registered as `pre:` in platformio.ini
+    (see [env] section). It therefore runs BEFORE SCons resolves the
+    `build_src_filter` into a final source list. At that point, replacing
+    `PIOBUILDFILES` is effective — the modification is picked up by the
+    Glob() that SCons runs later.
+
+    This mirrors the approach used by
+    `combus_test_add_generated_source.py` for the test env (which is
+    known to work). Both that script and this one run as `pre:` scripts
+    and use `env.Replace(PIOBUILDFILES=...)`.
+
+    Idempotent: if the file is already in PIOBUILDFILES, nothing happens.
+    No-op when the file does not exist (COMBUS_BUILDER_SKIP=1 with no
+    pre-existing artefacts — the build will fail at link time with a
+    clear error, which is the desired behaviour).
+    """
+    if target_env is None:
+        return
+    cpp_path = out_dir / "combus.cpp"
+    if not cpp_path.is_file():
+        return
+    sources = target_env.get("PIOBUILDFILES", [])
+    sources = [sources] if isinstance(sources, str) else list(sources)
+    src_str = str(cpp_path)
+    if src_str not in sources:
+        sources.append(src_str)
+        target_env.Replace(PIOBUILDFILES=sources)
+    print(f"[combus_scons_hook] PIOBUILDFILES += {src_str}")
+
+
 # =============================================================================
 # Main pipeline
 # =============================================================================
@@ -376,6 +424,38 @@ def main(env) -> int:
     out_dir_str = str(out_dir)
     _add_to_cpppath(env, out_dir_str, "env")
     _add_to_cpppath(projenv, out_dir_str, "projenv")
+    # --- 6b. libdeps CPPPATH (for combus.cpp compile) ----------------------
+    # The generated combus.cpp transitively includes <pin_defs.h> via
+    # <struct/combus_struct.h> -> <defs/machines_defs.h>. pin_defs.h is
+    # provided by the `common_defs` library, whose include path lives
+    # under `.pio/libdeps/<pio_env>/common_defs/include/`. The library
+    # is auto-CPPPATH'd for `env` after extends resolution; in `pre:`
+    # mode the env may not yet know about it, so we add it explicitly
+    # for the envs that need it. Mirrors the test helper script
+    # `combus_test_add_generated_source.py`.
+    project_dir = env.get("PROJECT_DIR")
+    pio_env = env.get("PIOENV") or "default"
+    if project_dir:
+        candidate = Path(project_dir) / ".pio" / "libdeps" / pio_env / "common_defs" / "include"
+        if candidate.is_dir():
+            for te in (env, projenv):
+                if te is None:
+                    continue
+                cpppath = te.get("CPPPATH", [])
+                cpppath = [cpppath] if isinstance(cpppath, str) else list(cpppath)
+                if str(candidate) not in cpppath:
+                    cpppath.append(str(candidate))
+                    te["CPPPATH"] = cpppath
+            print(f"[combus_scons_hook] CPPPATH += {candidate}")
+    # --- 7. PIOBUILDFILES (combus.cpp runtime) -----------------------------
+    # The generated combus.cpp defines the runtime `comBus` instance plus
+    # the AnalogComBusArray[] and DigitalComBusArray[] data. It must be
+    # compiled into every env that references `comBus` (machines, sound,
+    # remotes, test). The test env has its own helper script
+    # (combus_test_add_generated_source.py) that also adds the .cpp; the
+    # two paths are idempotent and the double-add is harmless.
+    _add_generated_cpp_to_sources(env, out_dir)
+    _add_generated_cpp_to_sources(projenv, out_dir)
     return 0
 
 
