+/*!****************************************************************************
+ * @file  runlevel_config.h
+ * @brief Dumper truck — INPUT runlevel chain: cfg, proc array.
+ *
+ * @details Private include — included only from proc_config.cpp.
+ *   Context provided by umbrella (do not include standalone):
+ *     CbRunlevelCfg, CbProc, cb_runlevel_fn,
+ *     AnalogComBusID, DigitalComBusID, RunLevel, comBus.
+ *
+ *   Chain function: RUNLEVEL → [failsafe, runlevel] → RUNLEVEL.
+ *   In:  RUNLEVEL (current RunLevel value, seeded into pipeline value).
+ *   Out: RUNLEVEL (committed after pipeline).
+ *
+ *   1  failsafe:  inCh = FAILSAFE.  When FAILSAFE=true → write RUNLEVEL=FAILSAFE
+ *                 (= IDLE alias) and claim the chain (blocks runlevel proc).
+ *                 When FAILSAFE=false → no write, no claim.
+ *   2  runlevel:  inCh = KEY_ACTIVE.  When KEY_ACTIVE=true → write RUNLEVEL=STARTING.
+ *                 When KEY_ACTIVE=false → write RUNLEVEL=TURNING_OFF.
+ *                 No claim (last proc in chain).
+ *
+ *   The chain uses read-modify-write: the runner seeds `value` from RUNLEVEL,
+ *   each proc may overwrite it, and the final value is committed back to RUNLEVEL.
+ *******************************************************************************
+ */
+#pragma once
+
+
+// =============================================================================
+// 1. CONFIG
+// =============================================================================
+
+  ///  failsafe — FAILSAFE=true → force RUNLEVEL=FAILSAFE (alias of IDLE), claim chain.
+static constexpr CbRunlevelCfg kFailsafeRunlevelCfg {
+    .high  = RunLevel::FAILSAFE,    ///< FAILSAFE=true → write FAILSAFE (= IDLE).
+    .low   = std::nullopt,          ///< FAILSAFE=false → no write.
+    .claim = true,                  ///< Block runlevel proc when failsafe is active.
+};
+
+  ///  runlevel — KEY_ACTIVE drives STARTING/TURNING_OFF.
+static constexpr CbRunlevelCfg kRunlevelCfg {
+    .high  = RunLevel::STARTING,    ///< KEY_ACTIVE=true → write STARTING.
+    .low   = RunLevel::TURNING_OFF, ///< KEY_ACTIVE=false → write TURNING_OFF.
+    .claim = false,                 ///< Last proc — nothing to protect behind.
+};
+
+
+// =============================================================================
+// 2. PROC ARRAY
+// =============================================================================
+
+/**
+ * @brief  Runlevel chain proc array.
+ * @details Steps:
+ *   1  failsafe : FAILSAFE=true → RUNLEVEL=FAILSAFE + claim (blocks runlevel).
+ *   2  runlevel : KEY_ACTIVE → RUNLEVEL=STARTING (true) or TURNING_OFF (false).
+ */
+static CbProc kRunlevelProcs[] = {
+      // 1. failsafe — FAILSAFE=true → force IDLE + claim chain.
+    { .name  = "failsafe",
+      .inCh  = DigitalComBusID::FAILSAFE,
+      .fn    = cb_runlevel_fn,
+      .cfg   = &kFailsafeRunlevelCfg,
+      .state = nullptr,
+    },
+      // 2. runlevel — KEY_ACTIVE drives STARTING/TURNING_OFF.
