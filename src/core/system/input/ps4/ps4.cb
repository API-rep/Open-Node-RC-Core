# ps4.cb — Channels of the PS4 DualShock source (BOARD, requires HAS_REMOTE_PS4)
#
# The channels of the source, written by its backend (ps4_backend.cpp) on every
# read, already scaled:
#   - a stick: [0..max], neutral at the centre;
#   - an analog trigger (L2, R2): [neutral..max], neutral when released;
#   - a button: true when pressed.
# The reframer of the source (chain of the `source` stage) overwrites them in
# place right after a read; the mapper of the module then writes the inputs of
# the type from them.  Design: doc/WIP - Local remote.md §2, §4, §7.
#
# Notes:
# - BOARD scope: they exist on the board that acquires the commands only, and
#   never travel.
# - value: the safe value, written by the backend when the controller is not
#   connected (neutral, released).
# - requires: [HAS_REMOTE_PS4], the PS4 module; it needs HAS_REMOTE (checked by
#   ps4_backend.h).

channels:

# -----------------------------------------------------------------------------
# ANALOG — sticks and triggers
# -----------------------------------------------------------------------------

- id: PS4_LX
  infoName: "PS4 left stick X"
  type: analog
  theme: source
  scope: BOARD
  direction: none
  requires: [HAS_REMOTE_PS4]
  value: CbusNeutral

- id: PS4_LY
  infoName: "PS4 left stick Y"
  type: analog
  theme: source
  scope: BOARD
  direction: none
  requires: [HAS_REMOTE_PS4]
  value: CbusNeutral

- id: PS4_RX
  infoName: "PS4 right stick X"
  type: analog
  theme: source
  scope: BOARD
  direction: none
  requires: [HAS_REMOTE_PS4]
  value: CbusNeutral

- id: PS4_RY
  infoName: "PS4 right stick Y"
  type: analog
  theme: source
  scope: BOARD
  direction: none
  requires: [HAS_REMOTE_PS4]
  value: CbusNeutral

- id: PS4_L2
  infoName: "PS4 L2 trigger"
  type: analog
  theme: source
  scope: BOARD
  direction: none
  requires: [HAS_REMOTE_PS4]
  value: CbusNeutral

- id: PS4_R2
  infoName: "PS4 R2 trigger"
  type: analog
  theme: source
  scope: BOARD
  direction: none
  requires: [HAS_REMOTE_PS4]
  value: CbusNeutral

