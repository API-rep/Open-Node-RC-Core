# board_link_fail.cb — loss of a ComBus link between boards (contributor)
#
# BOARD_LINK_FAIL is true when at least one receiving link of this board to
# another board of the node (scope INTRA_NODE) is lost, or still never seen once
# its startup grace (startupGraceMs) has elapsed.  It is a contributor of the
# hard chain (failsafe_chain.cpp, FAILSAFE_HARD).
#
# Notes:
# - BOARD scope: only the board that owns the links knows their state.  The
#   whole node learns of it through FAILSAFE_HARD (both_or) and RUNLEVEL.
# - Written every cycle by com_rx_update(), from
#   combus_links_lost(LinkScope::INTRA_NODE); false when there is no such link.
#   A link that only transmits never counts.
# - value: fault (true) until com_rx_update() writes it.  The chain consumes it
#   every cycle (cb_or_fn, inCh == outCh): a contributor is read by one chain
#   only.
# - requires: [HAS_FAILSAFE, HAS_BOARD_LINK_FAILSAFE], the failsafe module and
#   this contributor.

channels:
  - id: BOARD_LINK_FAIL
    infoName: "ComBus link lost (FAILSAFE reaction)"
    type: digital
    scope: BOARD          # private to the board owning the links (NOT shared)
    theme: failsafe            # failsafe group (link health)
    direction: none       # BOARD scope: pure in-board state, no wire transport
    value: fault           # default to fault (failsafe-by-default — see chain reset)
    requires:
      - HAS_FAILSAFE
      - HAS_BOARD_LINK_FAILSAFE
