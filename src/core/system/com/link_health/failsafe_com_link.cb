# failsafe_com_link.cb — loss of a ComBus link with the FAILSAFE reaction
#
# This file declares the FAILSAFE_COM_LINK ComBus channel: true when at least
# one receiving ComBus link of the board whose loss policy is FAILSAFE (onLoss,
# by default an intra-node link) is lost, or still never seen once its startup
# grace (startupGraceMs) has elapsed.  It is a contributor of the FAILSAFE
# chain (failsafe_chain.cpp).
#
# Notes:
# - BOARD scope: only the board that owns the links knows their state.  The
#   whole node learns of it through FAILSAFE (both_or) and RUNLEVEL.
# - Written each cycle by com_rx_update() from combus_links_lost(FAILSAFE);
#   false when no such link exists.  A link that only transmits never counts.
# - value: high = fault until com_rx_update() writes it (failsafe-by-default);
#   the chain consumes it each cycle (cb_or_fn, inCh == outCh).
# - requires: HAS_FAILSAFE — no chain, no contributor.


channels:
  - id: FAILSAFE_COM_LINK
    infoName: "ComBus link lost (FAILSAFE reaction)"
    type: digital
    scope: BOARD          # private to the board owning the links (NOT shared)
    theme: com            # link-health channels share the `com` theme
    direction: none       # BOARD scope: pure in-board state, no wire transport
    value: high           # default to fault (failsafe-by-default — see chain reset)
    requires:
      - HAS_FAILSAFE
