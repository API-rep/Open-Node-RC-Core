# board_link_fail.cb — loss of a ComBus link between boards (contributor)
#
# This file declares the BOARD_LINK_FAIL ComBus channel: true when at least
# one receiving ComBus link of the board whose loss policy is FAILSAFE (onLoss,
# by default a link between the boards of the node) is lost, or still never
# seen once its startup grace (startupGraceMs) has elapsed.  It is a
# contributor: a chain of the failsafe module reads it (today the hard chain,
# failsafe_chain.cpp, FAILSAFE_HARD).  Link rework S2 will feed it by scope
# (links between boards) instead of by loss policy.
#
# Notes:
# - BOARD scope: only the board that owns the links knows their state.  The
#   whole node learns of it through the aggregator (both_or) and RUNLEVEL.
# - Written each cycle by com_rx_update() from combus_links_lost(FAILSAFE);
#   false when no such link exists.  A link that only transmits never counts.
# - value: high = fault until com_rx_update() writes it (failsafe-by-default);
#   the chain consumes it each cycle (cb_or_fn, inCh == outCh).  A contributor
#   is read by ONE chain only.
# - requires: [HAS_FAILSAFE, HAS_BOARD_LINK_FAILSAFE] — the failsafe module,
#   and this contributor (link rework S1b).


channels:
  - id: BOARD_LINK_FAIL
    infoName: "ComBus link lost (FAILSAFE reaction)"
    type: digital
    scope: BOARD          # private to the board owning the links (NOT shared)
    theme: failsafe            # failsafe group (link health)
    direction: none       # BOARD scope: pure in-board state, no wire transport
    value: fault           # default to fault (failsafe-by-default — see chain reset)
    requires:
      - HAS_FAILSAFE
      - HAS_BOARD_LINK_FAILSAFE
