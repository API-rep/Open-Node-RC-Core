# node_link_fail.cb — loss of a ComBus link (contributor)
#
# This file declares the NODE_LINK_FAIL ComBus channel: true when at least one
# receiving ComBus link of the board to another node (scope INTER_NODE, link
# rework S2) is not alive, never seen included (no grace).  It is a
# contributor: a chain of the failsafe module reads it (today the soft chain,
# remote_link_fallback_chain.cpp, FAILSAFE_SOFT).
#
# Notes:
# - BOARD scope: only the board that owns the links knows their state.  The
#   whole node learns of it through the aggregator and RUNLEVEL.
# - Written each cycle by com_rx_update() from combus_links_lost(IDLE);
#   false when no such link exists.  A link that only transmits never counts.
# - value: high = lost until com_rx_update() writes it (failsafe-by-default);
#   the chain consumes it each cycle (cb_or_fn, inCh == outCh).  A contributor
#   is read by ONE chain only.
# - requires: [HAS_FAILSAFE, HAS_NODE_LINK_FAILSAFE] — the failsafe module,
#   and this contributor (link rework S1b).


channels:
  - id: NODE_LINK_FAIL
    infoName: "ComBus link lost (IDLE reaction)"
    type: digital
    scope: BOARD          # private to the board owning the links (NOT shared)
    theme: failsafe            # failsafe group (link health)
    direction: none       # BOARD scope: pure in-board state, no wire transport
    value: fault           # default to "lost" (failsafe-by-default — see chain reset)
    requires:
      - HAS_FAILSAFE
      - HAS_NODE_LINK_FAILSAFE
