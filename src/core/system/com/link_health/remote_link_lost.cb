# remote_link_lost.cb — FAILSAFE_SOFT aggregator channel
#
# This file declares the FAILSAFE_SOFT ComBus channel. It is the
# AGGREGATED "any remote input source is alive" signal — the OR-merge
# result of all *_LINK_LOST contributors (PS4_DS4_BT_FAIL,
# NODE_LINK_FAIL, future ESP_NOW_LINK_LOST, …).
#
# FAILSAFE_SOFT is COMPUTED, not directly written by input sources:
#   - Input sources write their dedicated *_LINK_LOST channel each cycle
#     (false = healthy, true = fault — failsafe-by-default).
#   - The FAILSAFE_SOFT → IDLE fallback chain (see
#     src/core/system/com/link_health/remote_link_fallback_chain.cpp) reads each
#     contributor, OR-merges them, and writes the result to FAILSAFE_SOFT
#     via the same `both_or` direction semantics.
#   - Downstream consumers (FSM, runlevel handler, dashboards) only read
#     FAILSAFE_SOFT — they never look at the per-source contributors.
#
# This indirection solves the "open-drain ordering" issue raised during the
# chantier 12.5 review: instead of having every source clear a single shared
# "isAlive" flag (fragile — depends on evaluation order, easy to miss a source),
# each source owns its own contributor with explicit reset+OR semantics in
# the consumer chain.  The model mirrors failsafe_chain.cpp exactly.
#
# Notes:
# - SYSTEM scope: the channel is shared by all boards composing the local
#   node. Any board may read FAILSAFE_SOFT to react (FSM, dashboards).
#   Only the consumer chain (remote_link_fallback_update) writes it.
# - Direction [both_or]: uplink + downlink + OR-merge on import.  In
#   practice only the consumer chain writes; external code should read.
#   any fault wins on import.
# - value: high = remote link lost (failsafe-by-default).  The channel
#   stays "lost" until the consumer chain re-arms it to false (= healthy)
#   this cycle, which happens only if NO contributor reports fault.
# - type: digital (bool).
# - requires: [HAS_REMOTE_LINK_LOST_FALLBACK] — the channel exists only when the
#   aggregator chain is compiled in: its writer (the chain) and all its readers
#   (runlevel fallback proc, dashboards) are under the same flag.  A machine
#   without the fallback (autonomous) simply has no such channel.  In node mode
#   it is diffused (SYSTEM, both_or) to the boards without the flag.
#   The contributors are optional: PS4_DS4_BT_FAIL requires
#   INPUT_PS4_DS4_BT; NODE_LINK_FAIL (written every cycle by com_rx_update())
#   is always read by the chain.
# - NOT a contributor to the FAILSAFE aggregator (only "hard" faults
#   like VBAT / temperature are).  FAILSAFE_SOFT feeds its own,
#   optional fallback chain (IDLE on loss).
# - This channel replaces the historical FAILSAFE_COMBUS_LINK (FS1)
#   and the underlying `isDrived` / `isNotDrived` open-drain flag on
#   ComBus (see failsafe_module.md §12.5 new design).  The semantics
#   are equivalent, but the responsibility is moved out of the Failsafe
#   module and into the input chain (machine-autonomy friendly).


channels:
  - id: FAILSAFE_SOFT
    infoName: "Remote input link lost (aggregated)"
    type: digital
    scope: SYSTEM
    theme: com            # link-health channels share the `com` theme
    direction: both_or   # aggregator writes via the consumer chain; readers consume
    value: high         # default to "lost" (failsafe-by-default — see chain reset)
    requires:
      - HAS_REMOTE_LINK_LOST_FALLBACK