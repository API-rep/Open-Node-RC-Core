# node_link_fail.cb — loss of a ComBus link to another node (contributor)
#
# NODE_LINK_FAIL is true when at least one receiving link of this board to
# another node (scope INTER_NODE) is not alive, never seen included: there is no
# grace, the other node may not be there.  It is a contributor of the soft chain
# (failsafe_soft_chain.cpp, FAILSAFE_SOFT).
#
# Notes:
# - BOARD scope: only the board that owns the links knows their state.  The
#   whole node learns of it through FAILSAFE_SOFT and RUNLEVEL.
# - Written every cycle by com_rx_update(), from
#   combus_links_lost(LinkScope::INTER_NODE); false when there is no such link.
#   A link that only transmits never counts, and a coupled link reports through
#   its own coupler instead.
# - value: fault (true) until com_rx_update() writes it.  The chain consumes it
#   every cycle (cb_or_fn, inCh == outCh): a contributor is read by one chain
#   only.
# - requires: [HAS_FAILSAFE, HAS_NODE_LINK_FAILSAFE], the failsafe module and
#   this contributor.

channels:
  - id: NODE_LINK_FAIL
    infoName: "ComBus link lost (IDLE reaction)"
    type: digital
    scope: BOARD          # private to the board owning the links (NOT shared)
    theme: failsafe            # failsafe group (link health)
    direction: none       # BOARD scope: pure in-board state, no wire transport
    value: fault           # default to "lost" (failsafe-by-default — see chain reset)
    requires:
      - HAS_FAILSAFE
      - HAS_NODE_LINK_FAILSAFE
