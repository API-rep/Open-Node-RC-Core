# combus_link_failsafe.cb — ComBus-link-as-Failsafe-contributor
#
# This file declares the ComBus-link Failsafe contributor channel. It is
# the single, authoritative "combus link alive" signal consumed by the
# FAILSAFE aggregator (declared in src/core/system/failsafe/failsafe.cb).
#
# Notes:
# - LOCAL scope: the contributor is shared by all boards composing the
#   local node. Any board performing combus RX (mainboard, extension
#   board, …) may publish the local "combus link alive" state. Other
#   boards (sound node, dashboard) consume it through the same LOCAL bus.
# - Direction [both]: uplink + downlink — any board may write (re-arm
#   each cycle) or read (react) the channel.
# - value: high = fail-safe by default. The contributor reports fault
#   until proven healthy each cycle (see WIP - Failsafe module design.md §5).
# - requires: [HAS_FAILSAFE, HAS_COMBUS_LINK_FAILSAFE] — the contributor
#   is only emitted when both flags are set (no aggregator → no contributor).
# - This channel replaces the historical `isDrived` open-drain flag on
#   ComBus (see RL0 audit). The semantics are inverted: `true` = fault
#   (no combus update this cycle), `false` = healthy (at least one
#   source refreshed the bus). The field is now named `isNotDrived` to
#   make the inverted semantics explicit.


channels:
  - id: FAILSAFE_COMBUS_LINK
    infoName: "ComBus link failsafe contributor"
    type: digital
    scope: LOCAL
    theme: failsafe
    direction: uplink_or
    value: high    # default to fault state: contributor reports fault until
                   # proven healthy. Failsafe-by-default contract.
    requires:
      - HAS_FAILSAFE
      - HAS_COMBUS_LINK_FAILSAFE
