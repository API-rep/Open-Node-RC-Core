# runlevel.cb — ComBus channel for machine run level
#
# This file declares the RUNLEVEL channel. It is the single, authoritative
# definition of the machine run level as a ComBus channel (replacing the
# historical `comBus.runLevel` struct field — see RL0 audit).
#
# Notes:
# - LOCAL scope: the run level is shared by all boards composing the
#   local node. The system FSM (main.cpp) writes it; consumers (light
#   interpreter, dashboards, processors) read it.
# - Direction [uplink]: a single writer (the "owner" board, typically the
#   mainboard) publishes the run level. Multiple readers consume it.
#   `both` was rejected to avoid silent multi-writer races — see RL1
#   discussion. The owner is gated by `-D HAS_RUNLEVEL_MANAGER`.
# - type: analog (uint16_t). The value is mapped to RunLevel enum
#   (include/defs/machines_defs.h) via static_cast on the C++ side.
#   Mapping: 0=IDLE, 1=STARTING, 2=RUNNING, 3=TURNING_OFF,
#            4=SLEEPING, 5=RESET.
# - value: 0 (IDLE default).
# - requires: [HAS_RUNLEVEL_MANAGER] — the channel is only emitted on
#   the board that owns the run level (mainboard by convention). Other
#   boards do not see the channel (future work: invert via LOCAL+link
#   convention so non-owner boards can still consume it).


channels:
  - id: RUNLEVEL
    infoName: "Machine run level"
    type: analog
    scope: LOCAL
    theme: core
    direction: uplink    # single writer (owner board, gated by HAS_RUNLEVEL_MANAGER)
    value: 0             # IDLE default (RunLevel::IDLE = 0)
    requires:
      - HAS_RUNLEVEL_MANAGER
