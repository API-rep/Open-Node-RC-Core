# runlevel.cb — ComBus channel for machine run level
#
# This file declares the RUNLEVEL channel. It is the single, authoritative
# definition of the machine run level as a ComBus channel.
#
# Notes:
# - SYSTEM scope: the run level is shared by all boards composing the
#   local node. Initialised by machine_init(), then written by the runlevel
#   chain (cb_runlevel); consumers (light interpreter, dashboards,
#   processors) read it.
# - Direction [uplink]: a single writer (the "owner" board, typically the
#   mainboard) publishes the run level. Multiple readers consume it.
#   Not `both`: it would allow silent multi-writer races. The owner is
#   gated by `-D HAS_RUNLEVEL_MANAGER`.
# - type: analog (uint16_t). The value is mapped to RunLevel enum
#   (include/defs/machines_defs.h) via static_cast on the C++ side.
#   Mapping: 0=IDLE, 1=STARTING, 2=RUNNING, 3=TURNING_OFF,
#            4=SLEEPING, 5=RESET.
# - value: 0 (IDLE default).
# - requires: [HAS_RUNLEVEL_MANAGER] — the channel is declared on the
#   board that owns the run level (mainboard by convention); in node mode
#   the other boards receive it by diffusion (downlink).


channels:
  - id: RUNLEVEL
    infoName: "Machine run level"
    type: analog
    scope: SYSTEM
    theme: core
    direction: uplink    # single writer (owner board, gated by HAS_RUNLEVEL_MANAGER)
    value: 0             # IDLE default (RunLevel::IDLE = 0)
    requires:
      - HAS_RUNLEVEL_MANAGER
