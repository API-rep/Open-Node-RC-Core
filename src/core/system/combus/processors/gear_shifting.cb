# gear_shifting.cb — Gear shifting flag (REMOTE)
#
# - GEAR_SHIFTING: written by SIM_GEAR chain (upshift-damp proc).
#   Set to 1 during the upshift damp window (upshiftDampMs) to signal
#   that a gear shift is in progress. Read by dashboard (shift indicator).
#   @todo winter 2026: promote GEAR_SHIFTING to WIRE region for sound node access.
#
# Theme: traction / gear.
# TEMPORARY LOCATION: this file lives at the root of src/core/system/combus/processors
# because GEAR_SHIFTING is a side-effect of the gear processor chain.
# Final destination: a "package" that bundles processor + combus together
# (created on-the-fly by the combus_builder).

channels:

# -----------------------------------------------------------------------------
# DIGITAL — gear shifting flag
# -----------------------------------------------------------------------------

- id: GEAR_SHIFTING
  infoName: "Gear shifting in progress (1=during upshift damp window)"
  type: digital
  theme: traction
  scope: REMOTE
  direction: none
