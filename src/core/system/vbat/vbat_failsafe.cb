# vbat_failsafe.cb — VBAT-as-Failsafe-contributor
#
# This file declares the ComBus channels related to the vbat module:
#   - FAILSAFE_VBAT : the Failsafe contributor (current contract).
#   - BATTERY_LOW   : DEPRECATED alias kept for the duration of the
#                     combus_builder v2 migration. Will be removed once
#                     the consumers (main.cpp, sound_module/main.cpp,
#                     sys_manager.h, dashboard_simulation.cpp) are
#                     migrated to FAILSAFE_VBAT.
#
# Legacy equivalent: src/core/config/vbat/combus_ids_digital_vbat_failsafe.inc
# FAILSAFE_VBAT,    ///< VBAT-as-Failsafe-contributor test channel — wired only when HAS_VBAT_FAILSAFE is set.
#
# Notes:
# - LOCAL scope is required because both channels are shared by all boards
#   composing the local node. Battery sensing may be performed by any of
#   these boards.
# - The channels are therefore readable and writable on the local wire:
#   both uplink and downlink are enabled.
# - Remote feedback, if required, is handled through a dedicated GLOBAL
#   ComBus definition and is outside the scope of these channels.
#
# A6.1 — `direction: [both]` shorthand added (TEMPORARY, pending .inc migration).
# During A6.1 the legacy .inc channels are not yet migrated, so the runtime
# writes/reads both ways. To be re-evaluated once .inc migration is complete.


channels:
  - id: FAILSAFE_VBAT
    infoName: "VBAT failsafe contributor"
    type: digital
    scope: LOCAL
    theme: failsafe
    direction: both
    value: high    # default to fault state: contributor reports fault until
                   # proven healthy. Failsafe-by-default contract.
    requires:
      - HAS_FAILSAFE
      - HAS_VBAT_FAILSAFE

  - id: BATTERY_LOW
    infoName: "Battery low flag (DEPRECATED — use FAILSAFE_VBAT)"
    type: digital
    scope: LOCAL
    theme: vbat
    direction: both
    value: low     # default: battery healthy. Written by vbat module when
                   # the cell voltage drops below the configured threshold.
                   # DEPRECATED: kept here only so the combus_builder v2
                   # migration compiles. Consumers should migrate to
                   # FAILSAFE_VBAT and this entry should then be removed.
    requires:
      - HAS_VBAT_FAILSAFE
