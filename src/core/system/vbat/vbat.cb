# vbat.cb — VBAT-as-Failsafe-contributor
#
# Ce fichier déclare le channel ComBus FAILSAFE_VBAT, qui permet au module
# vbat de signaler un état de batterie basse au système Failsafe.
#
# Équivalent legacy : src/core/config/vbat/combus_ids_digital_vbat_failsafe.inc
#   FAILSAFE_VBAT,    ///< VBAT-as-Failsafe-contributor test channel — wired only when HAS_VBAT_FAILSAFE is set.
#
# Notes :
# - Le channel BATTERY_LOW (digital, LOCAL) est déjà déclaré dans
#   src/core/config/machines/dumper_truck/combus/combus_ids_remote_digital.inc
#   (ligne 5). Il n'est PAS dupliqué ici.
# - Ce .cb ne déclare QUE le contributeur Failsafe (FAILSAFE_VBAT).
# - Le scope REMOTE est requis : le module core failsafe doit pouvoir
#   consommer ce channel sans couplage machine-specific.

module: vbat

channels:
  - id: FAILSAFE_VBAT
    infoName: "VBAT failsafe contributor"
    type: digital
    scope: REMOTE
    theme: failsafe
    requires:
      - HAS_FAILSAFE
      - HAS_VBAT_FAILSAFE
