# vbat_fail.cb — low battery (contributor)
#
# VBAT_FAIL is true when the battery is low.  It is a contributor of the hard
# chain (failsafe_chain.cpp, FAILSAFE_HARD).
#
# Notes:
# - SYSTEM scope: the board that senses the battery publishes it, and the other
#   boards of the node receive it.
# - Direction uplink_or: the declaring board sends it, the others receive it.
# - Written every cycle by vbat_update(), from vbat_is_low().
# - value: fault (true) until vbat_update() writes it.  The chain consumes it
#   every cycle (cb_or_fn, inCh == outCh): a contributor is read by one chain
#   only.
# - requires: [HAS_FAILSAFE, HAS_VBAT_FAILSAFE]: no aggregator, no contributor.

channels:
  - id: VBAT_FAIL
    infoName: "VBAT failsafe contributor"
    type: digital
    scope: SYSTEM
    theme: failsafe
    direction: uplink_or
    value: fault    # default to fault state: contributor reports fault until
                   # proven healthy. Failsafe-by-default contract.
    requires:
      - HAS_FAILSAFE
      - HAS_VBAT_FAILSAFE
