# failsafe_soft.cb — aggregator of the soft failsafe chain
#
# FAILSAFE_SOFT is true when at least one contributor of the soft chain reports a
# fault (today LOCAL_REMOTE_FAIL and NODE_LINK_FAIL).  Its reaction is the run
# level IDLE (the hard chain, FAILSAFE_HARD, leads to HALT).
#
# It is computed, never written by a source:
#   - each source writes its own contributor every cycle (false = healthy,
#     true = fault);
#   - the soft chain (failsafe_soft_chain.cpp) resets its value, ORs the
#     contributors it lists, and writes the result here;
#   - the consumers (runlevel chain, dashboards) only read FAILSAFE_SOFT.
#
# Notes:
# - SYSTEM scope: shared by all the boards of the node.  Only the soft chain
#   writes it.
# - Direction both_or: a fault of any board wins.
# - value: fault (true) until the chain first writes it.
# - requires: [HAS_FAILSAFE], the failsafe module.  The contributors are
#   optional, each under its own HAS_*_FAILSAFE flag; without any, the chain
#   writes false every cycle.

channels:
  - id: FAILSAFE_SOFT
    infoName: "Soft failsafe (aggregated)"
    type: digital
    scope: SYSTEM
    theme: failsafe            # failsafe group (link health)
    direction: both_or
    value: fault         # default to fault (failsafe-by-default — see chain reset)
    requires:
      - HAS_FAILSAFE
