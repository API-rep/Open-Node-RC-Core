# failsafe_hard.cb — aggregator of the hard failsafe chain
#
# FAILSAFE_HARD is true when at least one contributor of the hard chain reports a
# fault.  Its reaction is the run level HALT, held until a reboot (the soft
# chain, FAILSAFE_SOFT, leads to IDLE).
#
# It is computed, never written by a source:
#   - each source writes its own contributor every cycle (false = healthy,
#     true = fault);
#   - the hard chain (failsafe_chain.cpp) resets its value, ORs the contributors
#     it lists, and writes the result here;
#   - the consumers (runlevel chain, dashboards) only read FAILSAFE_HARD.
#
# Notes:
# - SYSTEM scope: shared by all the boards of the node.  A remote telemetry of the
#   failsafe state, if needed one day, would be a BASE channel of its own.
# - Direction both_or: a fault of any board wins.
# - value: fault (true) until the chain first writes it.
# - The contributors are declared next to the module that writes them (for
#   example src/core/system/vbat/vbat_fail.cb); see failsafe_module.md.

channels:
  - id: FAILSAFE_HARD
    infoName: "Failsafe aggregator"
    type: digital
    scope: SYSTEM
    theme: failsafe
    direction: both_or
    value: fault         # default to fault state: aggregator is HIGH (= true) until
                        # any contributor clears it. Failsafe-by-default contract.
    requires:
      - HAS_FAILSAFE
