# light.cb — Driver light / indicator / hazard channels (BASE) + motion-derived light states (SYSTEM)
#
# BASE channels (driver inputs):
# - LIGHTS: main lights toggle (head + tail).
#   Written by input module (PS4 controller).
#   Read by light module (kLedDescriptors[]).
# - INDICATOR_LEFT / INDICATOR_RIGHT: turn signals.
#   Written by input module.
#   Read by light module (indicator channels).
# - HAZARDS: hazard flashers (both indicators simultaneously).
#   Written by input module.
#   Read by light module.
#
# SYSTEM channels (motion-derived light states):
# - BRAKING: ESC braking state (1=braking, 0=not braking).
#   Written by motion module (MotionOutput::isBraking — future).
#   Read by light module (light_interpreter.cpp → LightBit::BRAKING).
#   scope: SYSTEM, direction: none — internal state, NOT on the wire.
#   Theme: light (consumer side), but scope: SYSTEM (producer side is motion).
#
# Theme: driver_inputs / signals (BASE) + motion-derived light states (SYSTEM).
# History: these channels used to be declared in hand-written .inc files of the
# Volvo instance (as REMOTE, the former name of BASE). They are now declared
# here at the TYPE level (generic to all dumper-trucks).

channels:

# -----------------------------------------------------------------------------
# DIGITAL — lights + indicators + hazards (BASE, driver inputs)
# -----------------------------------------------------------------------------

- id: LIGHTS
  infoName: "Main lights toggle"
  type: digital
  theme: light
  scope: BASE
  direction: downlink_pt
  value: low

- id: INDICATOR_LEFT
  infoName: "Left turn indicator"
  type: digital
  theme: light
  scope: BASE
  direction: downlink_pt
  value: low

- id: INDICATOR_RIGHT
  infoName: "Right turn indicator"
  type: digital
  theme: light
  scope: BASE
  direction: downlink_pt
  value: low

- id: HAZARDS
  infoName: "Hazard flashers"
  type: digital
  theme: light
  scope: BASE
  direction: downlink_pt
  value: low

# -----------------------------------------------------------------------------
# DIGITAL — motion-derived light states (SYSTEM, internal)
# -----------------------------------------------------------------------------

- id: BRAKING
  infoName: "ESC braking state (1=braking, 0=not braking)"
  type: digital
  theme: light
  scope: SYSTEM
  direction: none
  value: low
