# key.cb — Engine key / runlevel channels (BASE)
#
# - KEY_BTN: physical key switch input (TRIANGLE on PS4 in dumper-truck layout).
#   Written by input module (PS4 controller).
#   Read by INPUT_KEY_RUNLEVEL chain (key_on + key_off + runlevel).
# - KEY_ACTIVE: engine on/off flag (0 = off, 1 = on).
#   Written by INPUT_KEY_RUNLEVEL chain.
#   Read by main loop (RunLevel FSM, sleep timeout), dashboard.
#
# Theme: power / runlevel.
# History: these channels used to be declared in hand-written .inc files of the
# Volvo instance (as REMOTE, the former name of BASE). They are now declared
# here at the TYPE level (generic to all dumper-trucks).

channels:

# -----------------------------------------------------------------------------
# DIGITAL — key switch + active flag
# -----------------------------------------------------------------------------

- id: KEY_BTN
  infoName: "Engine key button (raw, TRIANGLE)"
  type: digital
  theme: core
  scope: BASE
  direction: downlink

- id: KEY_ACTIVE
  infoName: "Engine active flag (0=off, 1=on)"
  type: digital
  theme: core
  scope: BASE
  direction: none
