# input.cb — Raw input acquisition channels (SYSTEM, direction: none)
#
# Purpose:
#   - Defines the raw acquisition channels (sticks + buttons) that input_update()
#     writes each loop, before any INPUT/SIM processor conditions them.
#   - The buttons a remote can send too are BASE commands in combus/
#     (KEY_BTN, DIRECT_DRIVE_BTN, CRUISE_TOGGLE_BTN; link rework recadrage of
#     2026-10-25).
#   - These channels live in firmware ONLY — NEVER transmitted on the wire
#     (direction: none). They are private to the acquisition layer.
#   - They are the SOURCE side of the input mapping (PS4_dualshock_map.cpp)
#     and the INPUT side of subsequent processors (THROTTLE_BUS, etc.).
#
# Scope: SYSTEM
#   - Per ChanLayer spec: "Local firmware caller + extension boards caller
#     of same node". input_update() is the local firmware producer.
#   - direction: none  → not on the wire (NOT uplink, NOT downlink).
#
# Wire format:
#   - analog channels: uint16_t [0..65535], post map() from device raw domain.
#   - digital channels: bool.
#   - Device raw sources from PS4_dualshock.cpp descriptors
#     (sticks: [-127,+127], triggers: [0,255]).
#
# History (A9.9):
#   - These channels used to be declared in hand-written .inc files of the
#     Volvo instance, as LOCAL/REMOTE (former names of SYSTEM/BASE) — both
#     ill-named per ChanLayer spec (raw acquisition is intra-firmware, not on
#     the wire).
#   - They are now the canonical default for ANY dumper_truck instance
#     (Cat 770, Bell B45, Komatsu HD785, ...).
#   - This .cb file is the source of truth; the ComBus Builder generates the
#     enums and arrays.
#
# Runtime source chain:
#   PS4 hardware → input_manager::inputAnalogValue[] (int16_t, raw)
#                → input_update() map() → bus[CHANNEL].value (uint16_t)
#                → INPUT processors (THROTTLE_BUS, etc.) or direct consumers
#                → consumer (sim_brake, INPUT_SUBGEAR, etc.)

channels:

# -----------------------------------------------------------------------------
# ANALOG — sticks (PS4 DualShock axis)
# -----------------------------------------------------------------------------

- id: THROTTLE_STICK
  infoName: "Throttle stick (raw, LY)"
  type: analog
  theme: core
  scope: SYSTEM
  direction: none
  
- id: STEERING_STICK
  infoName: "Steering stick (raw, LX)"
  type: analog
  theme: core
  scope: SYSTEM
  direction: none

- id: DUMP_STICK
  infoName: "Dump stick (raw, RY)"
  type: analog
  theme: core
  scope: SYSTEM
  direction: none
# -----------------------------------------------------------------------------
# DIGITAL — buttons (PS4 DigitalInputDevID)
# -----------------------------------------------------------------------------

- id: SUBGEAR_SET_BTN
  infoName: "Sub-gear toggle button (raw, SHARE)"
  type: digital
  theme: core
  scope: SYSTEM
  direction: none

- id: GEAR_UP_BTN
  infoName: "Gear up button (raw, UP_ARROW)"
  type: digital
  theme: core
  scope: SYSTEM
  direction: none

- id: GEAR_DOWN_BTN
  infoName: "Gear down button (raw, DOWN_ARROW)"
  type: digital
  theme: core
  scope: SYSTEM
  direction: none

- id: CRUISE_UPDATE_BTN
  infoName: "Cruise update button (raw, L3)"
  type: digital
  theme: core
  scope: SYSTEM
  direction: none

- id: HORN_BTN
  infoName: "Horn button (raw, CIRCLE)"
  type: digital
  theme: core
  scope: SYSTEM
  direction: none
