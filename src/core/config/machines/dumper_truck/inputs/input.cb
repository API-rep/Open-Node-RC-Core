# input.cb — Inputs of the machine type (BOARD, requires HAS_REMOTE)
#
# Purpose:
#   - Defines the inputs (sticks + buttons) the command source writes, before
#     any INPUT/SIM processor conditions them.  The three other inputs are in
#     combus/ (KEY_BTN, DIRECT_DRIVE_BTN, CRUISE_TOGGLE_BTN).
#   - They are the SOURCE side of the input mapping (PS4_dualshock_map.cpp)
#     and the INPUT side of subsequent processors (THROTTLE_BUS, etc.).
#   - The remote link carries them (kRemoteLink): the remote sends them.
#
# Scope: BOARD, requires: [HAS_REMOTE]
#   - They exist on the board that acquires the commands only (HAS_REMOTE):
#     not in the BASE MD5, not in the frames between boards, not in the RAM
#     of the other boards.  WIP - Local remote §2.
#
# Wire format:
#   - analog channels: uint16_t [0..65535], post map() from device raw domain.
#   - digital channels: bool.
#   - Device raw sources from PS4_dualshock.cpp descriptors
#     (sticks: [-127,+127], triggers: [0,255]).
#
# Type level:
#   - These channels are the default for ANY dumper_truck instance
#     (Cat 770, Bell B45, Komatsu HD785, ...).
#   - This .cb file is the source of truth; the ComBus Builder generates the
#     enums and arrays.
#
# Runtime source chain:
#   PS4 hardware → input_manager::inputAnalogValue[] (int16_t, raw)
#                → input_update() map() → bus[CHANNEL].value (uint16_t)
#                → INPUT processors (THROTTLE_BUS, etc.) or direct consumers
#                → consumer (sim_brake, INPUT_SUBGEAR, etc.)

channels:

# -----------------------------------------------------------------------------
# ANALOG — sticks (PS4 DualShock axis)
# -----------------------------------------------------------------------------

- id: THROTTLE_STICK
  infoName: "Throttle stick (raw, LY)"
  type: analog
  theme: core
  scope: BOARD
  requires: [HAS_REMOTE]
  value: CbusNeutral
  
- id: STEERING_STICK
  infoName: "Steering stick (raw, LX)"
  type: analog
  theme: core
  scope: BOARD
  requires: [HAS_REMOTE]
  value: CbusNeutral

- id: DUMP_STICK
  infoName: "Dump stick (raw, RY)"
  type: analog
  theme: core
  scope: BOARD
  requires: [HAS_REMOTE]
  value: CbusNeutral
# -----------------------------------------------------------------------------
# DIGITAL — buttons (PS4 DigitalInputDevID)
# -----------------------------------------------------------------------------

- id: SUBGEAR_SET_BTN
  infoName: "Sub-gear toggle button (raw, SHARE)"
  type: digital
  theme: core
  scope: BOARD
  requires: [HAS_REMOTE]
  value: low

- id: GEAR_UP_BTN
  infoName: "Gear up button (raw, UP_ARROW)"
  type: digital
  theme: core
  scope: BOARD
  requires: [HAS_REMOTE]
  value: low

- id: GEAR_DOWN_BTN
  infoName: "Gear down button (raw, DOWN_ARROW)"
  type: digital
  theme: core
  scope: BOARD
  requires: [HAS_REMOTE]
  value: low

- id: CRUISE_UPDATE_BTN
  infoName: "Cruise update button (raw, L3)"
  type: digital
  theme: core
  scope: BOARD
  requires: [HAS_REMOTE]
  value: low

- id: HORN_BTN
  infoName: "Horn button (raw, CIRCLE)"
  type: digital
  theme: core
  scope: BOARD
  requires: [HAS_REMOTE]
  value: low
