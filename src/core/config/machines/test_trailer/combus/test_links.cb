# test_links.cb — BASE profile of the TEST trailer type (link rework, step 3.1)
#
# A fictitious machine type used only by the tests of the links between
# nodes (pytest, and the Unity test env).  Never loaded by a real machine:
# the machine type filter keeps only the active type (MACHINE_TYPE_TEST_TRAILER).
# Names are prefixed TEST_ (see test_tractor/combus/test_links.cb).
#
# Directions are those of the trailer (node view):
# - TEST_BRAKE_BUS, TEST_LIGHTS: received from the tractor;
# - TEST_TILT_ANGLE: sent to the tractor;
# - TEST_COUPLED_FAIL: fault shared by the whole convoy (OR merge);
# - TEST_AXLE_LOAD: sent, but the tractor does not know it.

channels:

- id: TEST_BRAKE_BUS
  infoName: "Test brake"
  type: analog
  scope: BASE
  theme: light
  direction: downlink
  value: 0

- id: TEST_TILT_ANGLE
  infoName: "Test tilt angle"
  type: analog
  scope: BASE
  theme: core
  direction: uplink
  value: CbusNeutral

- id: TEST_AXLE_LOAD
  infoName: "Test axle load"
  type: analog
  scope: BASE
  theme: core
  direction: uplink
  value: 0

- id: TEST_LIGHTS
  infoName: "Test lights"
  type: digital
  scope: BASE
  theme: light
  direction: downlink
  value: low

- id: TEST_COUPLED_FAIL
  infoName: "Test convoy fault"
  type: digital
  scope: BASE
  theme: failsafe
  direction: both_or
  value: low
