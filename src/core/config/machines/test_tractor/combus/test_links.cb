# test_links.cb — BASE profile of the TEST tractor type (link rework, step 3.1)
#
# A fictitious machine type used only by the tests of the links between
# nodes (pytest, and the Unity test env).  Never loaded by a real machine:
# the machine type filter keeps only the active type (MACHINE_TYPE_TEST_TRACTOR).
# Names are prefixed TEST_ so that an env without machine type (which loads
# every type) cannot clash with a real profile.
#
# Directions are those of the tractor (node view):
# - TEST_BRAKE_BUS, TEST_LIGHTS: received from the remote, relayed to the trailer;
# - TEST_THROTTLE_BUS: received from the remote, not relayed;
# - TEST_TILT_ANGLE: received from the trailer;
# - TEST_COUPLED_FAIL: fault shared by the whole convoy (OR merge);
# - TEST_BEACON: received from the remote, not relayed (the trailer does not
#   know it).  It comes before the digital channels of the link in the local
#   order, so that the table of the link is not the identity (step 3.1b).

channels:

- id: TEST_BRAKE_BUS
  infoName: "Test brake"
  type: analog
  scope: BASE
  theme: core
  direction: downlink_pt
  value: 0

- id: TEST_THROTTLE_BUS
  infoName: "Test throttle"
  type: analog
  scope: BASE
  theme: core
  direction: downlink
  value: CbusNeutral

- id: TEST_TILT_ANGLE
  infoName: "Test trailer tilt angle"
  type: analog
  scope: BASE
  theme: core
  direction: downlink
  value: CbusNeutral

- id: TEST_BEACON
  infoName: "Test beacon"
  type: digital
  scope: BASE
  theme: core
  direction: downlink
  value: low

- id: TEST_LIGHTS
  infoName: "Test lights"
  type: digital
  scope: BASE
  theme: light
  direction: downlink_pt
  value: low

- id: TEST_COUPLED_FAIL
  infoName: "Test convoy fault"
  type: digital
  scope: BASE
  theme: failsafe
  direction: both_or
  value: fault
