# ps4_ds4_bt_link_lost.cb — PS4 DualShock Bluetooth link health signal
#
# This file declares the PS4_DS4_BT_LINK_LOST ComBus channel. It is the
# dedicated "PS4 BT link alive" signal of the PS4 DualShock Bluetooth input
# backend (src/core/config/inputs/PS4_dualshock.*). The REMOTE_LINK_LOST
# fallback chain (src/core/system/com/link_health/remote_link_fallback_chain.cpp)
# consumes it when HAS_REMOTE_LINK_LOST_FALLBACK is defined.
#
# Notes:
# - BOARD scope: private to the board owning the PS4 backend (not shared and
#   not on the wire).  Only a BOARD caller may write it: the backend writes it
#   from src/machines/system/input/input_update.cpp.
# - value: high = PS4 link lost (failsafe-by-default).  The backend re-arms it
#   to false (= healthy) each cycle while the controller is connected; the
#   consumer chain puts it back to true after reading it (cb_or_fn: consume +
#   guard), so its instantaneous value on the bus is not the link state: read
#   REMOTE_LINK_LOST instead.
# - requires: [INPUT_PS4_DS4_BT] — the channel exists only when the flag is
#   defined (node mode: per board; single environment: for the environment;
#   the builder logs a channel it does not generate).  An environment without
#   the PS4 backend (autonomous machine) simply has no such channel.  Its
#   writer (input_update.cpp) and its reader (the fallback chain) are under the
#   same flag.
# - theme: com — all link-health channels share the `com` theme.
# - type: digital (bool).
# - This channel is a CONTRIBUTOR to REMOTE_LINK_LOST (chantier 12.5
#   new design).  The REMOTE_LINK_LOST channel is the OR-aggregated
#   result of all *_LINK_LOST contributors.  See failsafe_module.md
#   §12.5 (new design).


channels:
  - id: PS4_DS4_BT_LINK_LOST
    infoName: "PS4 DualShock Bluetooth link lost"
    type: digital
    scope: BOARD        # private to the board owning the PS4 backend (NOT shared)
    theme: com          # link-health channels share the `com` theme
    direction: none       # BOARD scope: pure in-board state, no wire transport
    value: high         # default to "lost" (failsafe-by-default — see chain reset)
    requires:
      - INPUT_PS4_DS4_BT
