# local_remote_fail.cb — health of the local remote (contributor)
#
# This file declares the LOCAL_REMOTE_FAIL ComBus channel: the "local remote
# alive" signal of the active local input backend (today the PS4 DualShock
# Bluetooth backend, src/core/config/inputs/PS4_dualshock.*; tomorrow a PPM /
# SBUS receiver).  It is a contributor: a chain of the failsafe module reads it
# (today the soft chain, remote_link_fallback_chain.cpp, FAILSAFE_SOFT).
#
# Notes:
# - BOARD scope: private to the board owning the input backend (not shared and
#   not on the wire).  Only a BOARD caller may write it: the backend writes it
#   from src/machines/system/input/input_update.cpp.
# - value: high = local remote lost (failsafe-by-default).  The backend
#   re-arms it to false (= healthy) each cycle while the remote is connected;
#   the consumer chain puts it back to true after reading it (cb_or_fn: consume
#   + guard), so its instantaneous value on the bus is not the link state: read
#   the aggregator instead.  A contributor is read by ONE chain only.
# - requires: [HAS_FAILSAFE, HAS_LOCAL_REMOTE_FAILSAFE] — the failsafe module,
#   and this contributor (link rework S1b).  The backend writes it only when
#   its own INPUT_* flag is set too.
# - theme: com — link-health channels (merged into `failsafe` in S3).
# - type: digital (bool).


channels:
  - id: LOCAL_REMOTE_FAIL
    infoName: "Local remote link lost"
    type: digital
    scope: BOARD        # private to the board owning the input backend (NOT shared)
    theme: com          # link-health channels share the `com` theme
    direction: none       # BOARD scope: pure in-board state, no wire transport
    value: high         # default to "lost" (failsafe-by-default — see chain reset)
    requires:
      - HAS_FAILSAFE
      - HAS_LOCAL_REMOTE_FAILSAFE
