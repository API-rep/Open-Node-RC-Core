# local_remote_fail.cb — loss of the local remote (contributor)
#
# LOCAL_REMOTE_FAIL is true when the active local input backend no longer
# answers (today the PS4 DualShock Bluetooth backend,
# src/core/config/inputs/PS4_dualshock.*; tomorrow a PPM or SBUS receiver).  It
# is a contributor of the soft chain (failsafe_soft_chain.cpp, FAILSAFE_SOFT).
#
# Notes:
# - BOARD scope: private to the board owning the input backend.  Only a BOARD
#   writer may write it: the backend, from src/machines/system/input/input_update.cpp.
# - value: fault (true) = local remote lost.  The backend writes false every cycle
#   while the remote is connected; the chain puts it back to true after reading
#   it (cb_or_fn, consume and guard).  Its value on the bus is therefore not the
#   link state: read FAILSAFE_SOFT instead.  A contributor is read by one chain
#   only.
# - requires: [HAS_FAILSAFE, HAS_LOCAL_REMOTE_FAILSAFE], the failsafe module and
#   this contributor.  The backend writes it only when its own INPUT_* flag is
#   set too.

channels:
  - id: LOCAL_REMOTE_FAIL
    infoName: "Local remote link lost"
    type: digital
    scope: BOARD        # private to the board owning the input backend (NOT shared)
    theme: failsafe          # failsafe group (link health)
    direction: none       # BOARD scope: pure in-board state, no wire transport
    value: fault         # default to "lost" (failsafe-by-default — see chain reset)
    requires:
      - HAS_FAILSAFE
      - HAS_LOCAL_REMOTE_FAILSAFE
