# test_coupler.cb — the TEST coupler
#
# A fictitious coupler used only by the tests (pytest, and the Unity test
# env), carried by the TEST tractor (socket) and the TEST trailer (plug).  A coupler is the norm of a link, like a standard plug: its
# channels are the full contract of the link, whatever the machines carrying
# it know.  A channel of the coupler unknown to a machine type is injected in
# the ComBus of the node, at its safe value.
#
# A coupler is a brick of the machine: directions are those of the SOCKET,
# as in any .cb of the machine (the plug gets its side of the coupler):
# - TEST_BRAKE_BUS, TEST_LIGHTS: received from the remote, relayed to the
#   plug (downlink_pt);
# - TEST_TILT_ANGLE, TEST_AXLE_LOAD: received from the plug (the TEST
#   tractor does not know TEST_AXLE_LOAD: injected, an absent function);
# - TEST_COUPLED_FAIL: fault shared by the whole convoy (OR merge).
#
# Local channels: BOARD (or SYSTEM when the switch sits on another
# board of the node), they require the flag of one side of the coupler
# (HAS_COUPLER_SOCKET_TEST_COUPLER), so they exist on that side only and never
# travel on the link; their names start with the name
# of the coupler (TEST_COUPLER_), so that several couplers on one machine never
# clash.  The coupling button is not here: an input from the remote belongs to
# the input contract of the machine type (TEST_COUPLER_BTN, test_tractor):
# - TEST_COUPLER_CMD: the latched coupling command, the trigger of the
#   CouplingDev, written by the chain of the coupler (test_coupler_chain.cpp);
#   low at boot: a new press is needed after a reboot;
# - TEST_COUPLER_COUPLED: coupled (CouplingDev::coupled): written by the
#   core, COUPLED and the engaged switch settled (the detector);
# - TEST_COUPLER_ENGAGED_SW: the engaged switch of the coupler, an optional
#   guard ("you may couple"), present with HAS_TEST_COUPLER_ENGAGED_SW.

channels:

- id: TEST_BRAKE_BUS
  infoName: "Test brake"
  type: analog
  scope: BASE
  theme: core
  direction: downlink_pt
  value: CbusNeutral

- id: TEST_TILT_ANGLE
  infoName: "Test tilt angle"
  type: analog
  scope: BASE
  theme: core
  direction: downlink
  value: CbusNeutral

- id: TEST_AXLE_LOAD
  infoName: "Test axle load"
  type: analog
  scope: BASE
  theme: core
  direction: downlink
  value: CbusNeutral

- id: TEST_LIGHTS
  infoName: "Test lights"
  type: digital
  scope: BASE
  theme: light
  direction: downlink_pt
  value: low

- id: TEST_COUPLED_FAIL
  infoName: "Test convoy fault"
  type: digital
  scope: BASE
  theme: failsafe
  direction: both_or
  value: fault

- id: TEST_COUPLER_CMD
  infoName: "Test coupler command"
  type: digital
  scope: BOARD
  theme: coupler
  value: low
  requires: [HAS_COUPLER_SOCKET_TEST_COUPLER]

- id: TEST_COUPLER_ENGAGED_SW
  infoName: "Test coupler engaged switch"
  type: digital
  scope: BOARD
  theme: coupler
  value: low
  requires: [HAS_COUPLER_SOCKET_TEST_COUPLER, HAS_TEST_COUPLER_ENGAGED_SW]

- id: TEST_COUPLER_COUPLED
  infoName: "Test coupler coupled"
  type: digital
  scope: BOARD
  theme: coupler
  value: low
  requires: [HAS_COUPLER_SOCKET_TEST_COUPLER]
