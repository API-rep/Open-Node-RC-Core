+    );
+    TEST_ASSERT_GREATER_THAN_UINT8(0u, lenLocal);
+
+    // Encode with FULL wire-end (12 analog, 19 digital).
+    uint8_t lenFull = combus_frame_encode(
+        kCfg, encodeBuf, &txComBus, 4u, false,
+        static_cast<uint8_t>(AnalogComBusID::CH_COUNT),
