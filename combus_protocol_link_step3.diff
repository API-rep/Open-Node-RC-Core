diff --git a/src/sound_module/init/com/combus_uart_init.cpp b/src/sound_module/init/com/combus_uart_init.cpp
--- a/src/sound_module/init/com/combus_uart_init.cpp
+++ b/src/sound_module/init/com/combus_uart_init.cpp
@@ -20,11 +20,28 @@
 void combus_uart_init()
 {
     static uint16_t s_analog[static_cast<uint8_t>(AnalogComBusID::CH_COUNT)];
     static bool     s_digital[static_cast<uint8_t>(DigitalComBusID::CH_COUNT)];
+
+        // P3 — caller-owned per-link handshake context.  Zero-initialised
+        //    at boot, shared between TX and RX of the same ComBus link
+        //    by combus_protocol_init().  This sound node is RX-only, so
+        //    the context is wired to RX only (TX side stays null).
+    static CombusHandshakeContext s_linkHandshakeCtx = {};
+
     constexpr ComBusFrameCfg rxCfg = {
         SOUND_TRANSPORT_ENV_ID,
         SOUND_TRANSPORT_N_ANALOG,
         SOUND_TRANSPORT_N_DIGITAL,
     };
-    combus_protocol_init(uart_get_combus_com(), {}, 0, rxCfg, s_analog, s_digital);
+
+    // --- Build the ComBusLink descriptor (RX-only) ---
+    ComBusLink link{};
+    link.com          = uart_get_combus_com();
+    link.layer        = ChanLayer::LOCAL;   ///< Sound node is a board of the same system as the
+                                            ///< machine mainboard — LOCAL matches ChanLayer::LOCAL
+                                            ///< ("shared between all boards of the same system").
+    link.handshakeCtx = &s_linkHandshakeCtx;
+    link.name         = "combus_sound";
+    link.rxCfg        = rxCfg;
+    link.analogBuf    = s_analog;
+    link.digitalBuf   = s_digital;
+
+    combus_protocol_init(&link);
 }

 #endif  // COMBUS_UART_RX / COMBUS_UART
